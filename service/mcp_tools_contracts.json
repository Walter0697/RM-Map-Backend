[
  {
    "name": "list_markers",
    "title": "list_markers",
    "description": "List markers with pagination and filters such as type, status, country, and country_part; use list_marker_types to get valid type values, and search (string or string[]) can match hashtag text from descriptions with OR logic for multiple terms.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200,
          "description": "Page size for results (MCP applies safety clamping)."
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "description": "Pagination offset, zero-based."
        },
        "search": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              },
              "minItems": 1
            }
          ],
          "description": "Free-text search terms across marker text fields (supports string or string array; array uses OR logic)."
        },
        "status": {
          "type": "string",
          "description": "Marker status filter."
        },
        "type": {
          "type": "string",
          "description": "Marker type value filter (recommended source: list_marker_types values)."
        },
        "country": {
          "type": "string",
          "description": "Exact country filter."
        },
        "country_part": {
          "type": "string",
          "description": "Exact country subdivision filter (city/area/region-like)."
        }
      },
      "required": [],
      "description": "List markers with optional pagination and filters."
    }
  },
